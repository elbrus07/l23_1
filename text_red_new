#include <gtkmm.h>
#include <iostream> // Обязательно для работы std::cout

class SimpleEditor : public Gtk::Window {
public:
    SimpleEditor() {
        set_title("Расширенный редактор (GTKMM 4)");
        set_default_size(800, 500);

        set_child(m_main_vbox);

        // 1. Панель инструментов
        m_button_box.set_margin(5);
        m_button_box.set_spacing(5);

        // Устанавливаем названия кнопок
        m_btn_new.set_label("Создать");
        m_btn_open.set_label("Открыть");
        m_btn_save.set_label("Сохранить");
        m_btn_copy.set_label("Копировать");
        m_btn_paste.set_label("Вставить");
        m_btn_undo.set_label("Отменить");

        // Добавляем все кнопки в горизонтальный контейнер
        m_button_box.append(m_btn_new);
        m_button_box.append(m_btn_open);
        m_button_box.append(m_btn_save);
        m_button_box.append(m_btn_copy);
        m_button_box.append(m_btn_paste);
        m_button_box.append(m_btn_undo);

        m_main_vbox.append(m_button_box);

        // 2. Область ввода текста
        m_scrolled_window.set_child(m_text_view);
        m_scrolled_window.set_policy(Gtk::PolicyType::AUTOMATIC, Gtk::PolicyType::AUTOMATIC);
        m_scrolled_window.set_expand(true);
        
        m_main_vbox.append(m_scrolled_window);

        // 3. Подключение сигналов
        m_btn_new.signal_clicked().connect(sigc::mem_fun(*this, &SimpleEditor::on_new_clicked));
        m_btn_open.signal_clicked().connect(sigc::mem_fun(*this, &SimpleEditor::on_open_clicked));
        m_btn_save.signal_clicked().connect(sigc::mem_fun(*this, &SimpleEditor::on_save_clicked));
        
        // Стандартные операции с буфером обмена и историей
        m_btn_copy.signal_clicked().connect(sigc::mem_fun(*this, &SimpleEditor::on_copy_clicked));
        m_btn_paste.signal_clicked().connect(sigc::mem_fun(*this, &SimpleEditor::on_paste_clicked));
        m_btn_undo.signal_clicked().connect(sigc::mem_fun(*this, &SimpleEditor::on_undo_clicked));
    }

protected:
    void on_new_clicked() {
        m_text_view.get_buffer()->set_text(""); 
    }

    void on_open_clicked() { std::cout << "Нажата кнопка: Открыть" << std::endl; }
    void on_save_clicked() { std::cout << "Нажата кнопка: Сохранить" << std::endl; }

    void on_copy_clicked() {
        auto buffer = m_text_view.get_buffer();
        auto clipboard = get_clipboard();
        buffer->copy_clipboard(clipboard);
        std::cout << "Текст скопирован" << std::endl;
    }

    void on_paste_clicked() {
        auto buffer = m_text_view.get_buffer();
        auto clipboard = get_clipboard();
        buffer->paste_clipboard(clipboard);
        std::cout << "Текст вставлен" << std::endl;
    }

    void on_undo_clicked() {
        // Простая заглушка, так как полноценный Undo требует хранения стека изменений
        std::cout << "Нажата кнопка: Отменить (требуется реализация стека)" << std::endl;
    }

    // Виджеты
    Gtk::Box m_main_vbox{Gtk::Orientation::VERTICAL};
    Gtk::Box m_button_box{Gtk::Orientation::HORIZONTAL};
    Gtk::Button m_btn_new, m_btn_open, m_btn_save, m_btn_copy, m_btn_paste, m_btn_undo;
    Gtk::ScrolledWindow m_scrolled_window;
    Gtk::TextView m_text_view;
};

int main(int argc, char* argv[]) {
    auto app = Gtk::Application::create("org.gtkmm.kamilla.editor");
    return app->make_window_and_run<SimpleEditor>(argc, argv);
}
